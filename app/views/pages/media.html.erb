<% scenes = [
  { id: "kylian",     image: "media/kylian.webp",        quote: "“The changing of a person into a dancer is the most beautiful thing.”", author: "Jiří Kylián",       url: "http://www.jirikylian.com/",                                  credit: "Blandine Soulage" },
  { id: "cunningham", image: "media/cunningham.webp",    quote: "“Falling is one of the ways of moving.”",                                 author: "Merce Cunningham",  url: "https://www.mercecunningham.org/about/merce-cunningham/",    credit: "Agathe Poupeney" },
  { id: "forsythe",   image: "media/forsythe.webp",      quote: "“No one has any idea what really works.”",                                author: "William Forsythe",  url: "https://www.williamforsythe.com",                            credit: "Agathe Poupeney" },
  { id: "maliphant",  image: "media/critical-mass.webp", quote: "Critical Mass",                                                           author: "Russell Maliphant", url: "https://www.russellmaliphantdancecompany.com/",              credit: "Blandine Soulage" },
  { id: "de-keersmaeker", image: "media/la-nuit-transfiguree.webp", quote: "La Nuit transfigurée",                                           author: "Anne Teresa De Keersmaeker", url: "https://www.rosas.be",                                 credit: "Marc Domage", credit_in_photo: true },
  { id: "papadopoulos",   image: "media/mycelium.webp",             quote: "Mycelium",                                                       author: "Christos Papadopoulos",      url: "https://christospapadopoulos.art",                     credit: "Agathe Poupeney" }
] %>
<% gallery = %w[forsythe kylian duo-fire jump duo-grey portrait-cutout studio critical-mass-lausanne beach-birds duo-blue stage-ball duo-wall] %>

<section class="media-intro wrap">
  <p class="stage-eyebrow"><%= t("stage.media.eyebrow") %></p>
  <h1 class="stage-title"><%= t("navbar.media") %></h1>
  <p class="media-intro__lead"><%= t("stage.media.intro") %></p>
  <nav class="chip-nav" aria-label="<%= t("stage.media.scenes") %>">
    <% scenes.each do |scene| %>
      <a href="#<%= scene[:id] %>" class="chip"><%= scene[:author] %></a>
    <% end %>
    <a href="#gallery" class="chip chip--ghost"><%= t("stage.media.gallery") %></a>
  </nav>
</section>

<% scenes.each_with_index do |scene, i| %>
  <section class="scene <%= "scene--reverse" if i.odd? %> wrap" id="<%= scene[:id] %>">
    <figure class="scene__figure">
      <%= image_tag scene[:image], alt: "Albert Nikolli · #{scene[:author]}", loading: (i.zero? ? "eager" : "lazy") %>
      <%# Some photos already carry the credit in the image itself %>
      <figcaption class="<%= scene[:credit_in_photo] ? "visually-hidden" : "scene__credit" %>">© <%= scene[:credit] %></figcaption>
    </figure>
    <div class="scene__caption">
      <blockquote><%= scene[:quote] %></blockquote>
      <% if scene[:url] %>
        <a href="<%= scene[:url] %>" target="_blank" rel="noopener"><%= scene[:author] %> <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      <% else %>
        <span class="scene__author"><%= scene[:author] %></span>
      <% end %>
    </div>
  </section>
<% end %>

<section class="media-video wrap">
  <h2 class="group-title group-title--light"><%= t("stage.media.video") %></h2>
  <div class="media-video__frame">
    <iframe src="https://player.vimeo.com/video/1050511459?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479&amp;autoplay=1&amp;muted=1&amp;controls=0&amp;loop=1&amp;quality=720p"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media" loading="lazy" title="Albert Nikolli on stage"></iframe>
  </div>
</section>

<section class="gallery wrap" id="gallery" data-controller="lightbox">
  <h2 class="group-title group-title--light"><%= t("stage.media.gallery") %></h2>
  <ul class="gallery__grid">
    <% gallery.each_with_index do |name, i| %>
      <li>
        <button type="button" class="gallery__item" data-action="lightbox#open" data-lightbox-index-param="<%= i %>" aria-label="<%= t("stage.media.open") %> <%= i + 1 %>">
          <%= image_tag "media/#{name}.webp", alt: "Albert Nikolli on stage", loading: "lazy", data: { lightbox_target: "image" } %>
        </button>
      </li>
    <% end %>
  </ul>

  <dialog class="lightbox" data-lightbox-target="dialog" data-action="click->lightbox#backdrop keydown->lightbox#key">
    <img data-lightbox-target="view" alt="">
    <button type="button" class="lightbox__btn lightbox__btn--close" data-action="lightbox#close" aria-label="<%= t("stage.media.close") %>"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    <button type="button" class="lightbox__btn lightbox__btn--prev" data-action="lightbox#prev" aria-label="<%= t("stage.media.prev") %>"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
    <button type="button" class="lightbox__btn lightbox__btn--next" data-action="lightbox#next" aria-label="<%= t("stage.media.next") %>"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
  </dialog>
</section>
