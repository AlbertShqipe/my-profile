<header class="site-nav site-nav--stage" data-controller="nav logo-bounce">
  <div class="logo-box-academic logo-box-academic--nav" id="logoBoxArtistic" title="Albert Nikolli · Arts & Software">
    <div class="logo-content-artistic-academic">
      <div class="logo-a-academic">A</div>
      <div class="logo-dark-spot-academic"></div>
      <div class="logo-slash-academic">|</div>
      <div class="logo-n-academic">N</div>
    </div>
  </div>

  <nav class="site-nav__menu" id="site-menu" data-nav-target="menu" aria-label="Main">
    <ul>
      <li><%= link_to t("navbar.biography"), biography_path, "aria-current": ("page" if action_name == "biography"), data: { action: "nav#close" } %></li>
      <li><%= link_to t("navbar.media"), media_path, "aria-current": ("page" if action_name == "media"), data: { action: "nav#close" } %></li>
    </ul>
    <%= link_to root_path, class: "btn-pill btn-pill--light" do %>
      <%= t("navbar.portfolio_link") %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    <% end %>
  </nav>

  <div class="site-nav__actions">
    <details class="lang-switch" data-controller="dropdown" data-action="click@window->dropdown#closeOutside keydown.esc@window->dropdown#close">
      <summary aria-label="<%= t("navbar.language") %>">
        <%= image_tag "#{I18n.locale}.png", alt: "", class: "lang-switch__flag" %>
        <span><%= I18n.locale.upcase %></span>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
      </summary>
      <ul>
        <% I18n.available_locales.each do |loc| %>
          <li>
            <%= link_to url_for(locale: loc), class: ("is-active" if I18n.locale == loc), hreflang: loc do %>
              <%= image_tag "#{loc}.png", alt: "", class: "lang-switch__flag" %>
              <%= t("i18n.languages.#{loc}") %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>

    <button class="site-nav__toggle" type="button" aria-controls="site-menu" aria-expanded="false"
            aria-label="<%= t("navbar.menu") %>" data-nav-target="toggle" data-action="nav#toggle">
      <span></span><span></span>
    </button>
  </div>
</header>
