<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <strong>Albert Nikolli</strong>
      <a href="<%= AcademicHelper::COMPANY_URL %>" target="_blank" rel="noopener"><%= t("footer.founder") %></a>
    </div>

    <ul class="social-list social-list--dark">
      <% AcademicHelper::SOCIAL_LINKS.each do |s| %>
        <li><a href="<%= s[:url] %>" aria-label="<%= s[:label] %>" target="_blank" rel="noopener"><i class="<%= s[:icon] %>" aria-hidden="true"></i></a></li>
      <% end %>
    </ul>

    <%= link_to root_path, class: "site-footer__top" do %>
      <%= t("navbar.portfolio_link") %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>
  <div class="wrap site-footer__legal">
    <p>© <%= Date.current.year %> Albert Nikolli. <%= t("footer.rights") %></p>
    <p><%= t("home.first_section.p_intro_2") %></p>
  </div>
</footer>
