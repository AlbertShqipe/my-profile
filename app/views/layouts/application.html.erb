<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Albert Nikolli · Arts & Software</title>
    <meta name="description" content="Albert Nikolli Arts & Software - A portfolio showcasing my work in art and software development.">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a0a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= favicon_link_tag 'N.png', type: "image/png" %>
  </head>

  <body class="<%= controller_name == "academic" ? "page-academic" : "page-stage" %>">
    <% if controller_name == "academic" %>
      <%= yield %>
    <% else %>
      <%= render "layouts/shared/navbar" %>
      <main class="stage"><%= yield %></main>
      <%= render "layouts/shared/footer_stage" %>
    <% end %>

    <% flash.each do |type, message| %>
      <div class="toast-flash toast-flash--<%= type %>" role="status" data-controller="flash">
        <span><%= message %></span>
        <button type="button" aria-label="Close" data-action="flash#dismiss">&times;</button>
      </div>
    <% end %>

    <button id="backToTop" type="button" aria-label="Back to the top" data-controller="back-to-top" data-action="back-to-top#scrollUp">
      <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>
  </body>
</html>
