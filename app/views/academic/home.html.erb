<% socials = AcademicHelper::SOCIAL_LINKS %>

<div class="home" id="top" data-controller="reveal">
  <header class="site-nav" data-controller="nav">
    <a href="#top" class="site-nav__brand">Albert Nikolli</a>

    <nav class="site-nav__menu" id="site-menu" data-nav-target="menu" aria-label="Main">
      <ul>
        <li><a href="#aboutMe" data-action="nav#close"><%= t("navbar.about") %></a></li>
        <li><a href="#company" data-action="nav#close"><%= t("navbar.company") %></a></li>
        <li><a href="#skills" data-action="nav#close"><%= t("navbar.skills") %></a></li>
        <li><a href="#portfolio" data-action="nav#close"><%= t("navbar.portfolio") %></a></li>
      </ul>
      <a href="#contactMe" class="btn-pill btn-pill--light" data-action="nav#close"><%= t("navbar.contact") %></a>
    </nav>

    <div class="site-nav__actions">
      <details class="lang-switch" data-controller="dropdown" data-action="click@window->dropdown#closeOutside keydown.esc@window->dropdown#close">
        <summary aria-label="<%= t("navbar.language") %>">
          <%= image_tag "#{I18n.locale}.png", alt: "", class: "lang-switch__flag" %>
          <span><%= I18n.locale.upcase %></span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </summary>
        <ul>
          <% I18n.available_locales.each do |loc| %>
            <li>
              <%= link_to url_for(locale: loc), class: ("is-active" if I18n.locale == loc), hreflang: loc do %>
                <%= image_tag "#{loc}.png", alt: "", class: "lang-switch__flag" %>
                <%= t("i18n.languages.#{loc}") %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </details>

      <button class="site-nav__toggle" type="button" aria-controls="site-menu" aria-expanded="false"
              aria-label="<%= t("navbar.menu") %>" data-nav-target="toggle" data-action="nav#toggle">
        <span></span><span></span>
      </button>
    </div>
  </header>

  <section class="hero" data-controller="logo-bounce">
    <div class="hero__panel">
      <div class="logo-box-academic" id="logoBox" title="Media">
        <div class="logo-content-artistic-academic">
          <div class="logo-a-academic">A</div>
          <div class="logo-dark-spot-academic"></div>
          <div class="logo-slash-academic">|</div>
          <div class="logo-n-academic">N</div>
        </div>
      </div>

      <div class="hero__copy">
        <p class="eyebrow">Arts &amp; Software</p>
        <h1 class="hero__title">Albert <em>Nikolli</em></h1>
        <p class="hero__role"><%= t("home.hero.role") %></p>
        <p class="hero__lead"><%= t("home.first_section.p_intro_1") %></p>

        <div class="hero__ctas">
          <a href="#portfolio" class="btn-pill btn-pill--dark">
            <%= t("home.hero.cta_work") %> <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
          </a>
          <a href="<%= AcademicHelper::COMPANY_URL %>" class="btn-pill btn-pill--ghost" target="_blank" rel="noopener">
            A.N Arts &amp; Software <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
          </a>
        </div>

        <ul class="social-list">
          <% socials.first(3).each do |s| %>
            <li><a href="<%= s[:url] %>" aria-label="<%= s[:label] %>" target="_blank" rel="noopener"><i class="<%= s[:icon] %>" aria-hidden="true"></i></a></li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="hero__media">
      <%= image_tag "speach.png", alt: "Albert Nikolli", class: "hero__photo", fetchpriority: "high" %>
      <%# Phones get the A|N logo intro instead of the photo %>
      <%# The poster is the clip's final view, so it shows even when autoplay is blocked %>
      <%= video_tag "video.mp4", class: "hero__video", muted: true, playsinline: true, preload: "none", poster: image_path("intro-poster.webp"),
            "aria-label": "A.N · Albert Nikolli, Arts and Software",
            data: { controller: "video", video_stop_at_value: 3, video_media_value: "(max-width: 900px)" } %>
    </div>
  </section>

  <section class="section section--light" id="aboutMe">
    <div class="wrap">
      <header class="section-head" data-reveal-target="item">
        <h2 class="section-title"><%= t("home.second_section.about") %></h2>
      </header>

      <div class="about__lead" data-reveal-target="item">
        <p><%= t("home.second_section.about_p") %></p>
        <p><%= t("home.second_section.about_p_2") %></p>
      </div>
    </div>
  </section>

  <section class="section section--dark company" id="company">
    <div class="wrap">
      <header class="section-head section-head--light" data-reveal-target="item">
        <h2 class="section-title">A.N Arts &amp; Software</h2>
        <p class="section-head__sub"><%= t("home.company.tagline") %></p>
      </header>

      <div class="company__intro" data-reveal-target="item">
        <%= image_tag "an/an-logo.png", alt: "A.N Arts & Software", class: "company__logo", loading: "lazy" %>
        <p><%= t("home.company.intro") %></p>
      </div>

      <div class="offers">
        <article class="offer offer--flagship" data-reveal-target="item">
          <span class="offer__label"><%= t("home.company.flagship") %></span>
          <h3>AN AUDITION</h3>
          <p><%= t("home.company.an_audition") %></p>

          <dl class="stats" data-controller="counter">
            <% AcademicHelper::AN_AUDITION_STATS.each do |value, suffix, key| %>
              <div class="stats__item">
                <dt><%= t("home.company.stats.#{key}") %></dt>
                <dd><span data-counter-target="number" data-value="<%= value %>"><%= value %></span><%= suffix %></dd>
              </div>
            <% end %>
          </dl>
        </article>

        <article class="offer" data-reveal-target="item" style="--delay: 90ms">
          <span class="offer__icon"><i class="fa-solid fa-code" aria-hidden="true"></i></span>
          <h3><%= t("home.company.software_title") %></h3>
          <p><%= t("home.company.software") %></p>
        </article>

        <article class="offer" data-reveal-target="item" style="--delay: 180ms">
          <span class="offer__icon"><i class="fa-solid fa-pen-ruler" aria-hidden="true"></i></span>
          <h3><%= t("home.company.web_title") %></h3>
          <p><%= t("home.company.web") %></p>
        </article>
      </div>

      <div class="trusted" data-reveal-target="item">
        <h3 class="group-title group-title--light"><%= t("home.company.trusted") %></h3>
        <ul class="logo-strip">
          <% AcademicHelper::AN_AUDITION_CLIENTS.each do |client| %>
            <li><%= image_tag client[:image], alt: client[:name], title: client[:name], loading: "lazy" %></li>
          <% end %>
        </ul>
      </div>

      <div class="company__cta">
        <a href="<%= AcademicHelper::COMPANY_URL %>" class="btn-pill btn-pill--light" target="_blank" rel="noopener">
          <%= t("home.company.visit") %> <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--muted" id="skills">
    <div class="wrap">
      <header class="section-head" data-reveal-target="item">
        <h2 class="section-title"><%= t("home.third_section.skills") %></h2>
      </header>

      <% [[t("home.third_section.using"), AcademicHelper::SKILLS_USING], [t("home.third_section.learning"), AcademicHelper::SKILLS_LEARNING]].each do |title, skills| %>
        <div class="skill-group" data-reveal-target="item">
          <h3 class="group-title"><%= title %></h3>
          <ul class="skill-grid">
            <% skills.each do |skill| %>
              <li class="skill">
                <%= image_tag "skills/#{skill}.svg", alt: "", class: "skill__logo", loading: "lazy" %>
                <span><%= skill_label(skill) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </section>

  <section class="section section--dark" id="portfolio">
    <div class="wrap">
      <header class="section-head section-head--light" data-reveal-target="item">
        <h2 class="section-title">PORTFOLIO</h2>
        <p class="section-head__sub"><%= t("home.forth_section.projects") %></p>
      </header>

      <% AcademicHelper::PORTFOLIO_PROJECTS.each do |group, projects| %>
        <div class="project-group">
          <h3 class="group-title group-title--light"><%= t("home.forth_section.#{group}") %></h3>
          <ul class="project-grid">
            <% projects.each_with_index do |project, i| %>
              <li data-reveal-target="item" style="--delay: <%= (i % 3) * 80 %>ms">
                <a class="project-card" href="<%= project[:url] %>" target="_blank" rel="noopener">
                  <span class="project-card__media <%= "project-card__media--light" if project[:light] %>">
                    <%= image_tag project[:image], alt: project[:name], loading: "lazy" %>
                  </span>
                  <span class="project-card__meta">
                    <span>
                      <% if project[:tag] %>
                        <span class="project-card__tag"><%= t("home.forth_section.tags.#{project[:tag]}") %></span>
                      <% end %>
                      <strong><%= project[:name] %></strong>
                      <small><%= project_host(project[:url]) %></small>
                    </span>
                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                  </span>
                </a>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <p class="many-more"><%= t("home.forth_section.many_more") %></p>
    </div>
  </section>

  <section class="section section--light" id="contactMe">
    <div class="wrap contact">
      <div class="contact__intro" data-reveal-target="item">
        <header class="section-head section-head--left">
          <h2 class="section-title"><%= t("home.fifth_section.contact") %></h2>
        </header>
        <p class="contact__text"><%= t("home.fifth_section.contact_p") %></p>
        <p class="contact__direct">
          <%= t("home.fifth_section.form.direct") %>
          <a href="mailto:<%= AcademicHelper::CONTACT_EMAIL %>"><%= AcademicHelper::CONTACT_EMAIL %></a>
        </p>
      </div>

      <div class="contact__form" data-reveal-target="item">
        <%= render "contacts/contact" %>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <div class="site-footer__brand">
        <strong>Albert Nikolli</strong>
        <a href="<%= AcademicHelper::COMPANY_URL %>" target="_blank" rel="noopener"><%= t("footer.founder") %></a>
      </div>

      <ul class="social-list social-list--dark">
        <% socials.each do |s| %>
          <li><a href="<%= s[:url] %>" aria-label="<%= s[:label] %>" target="_blank" rel="noopener"><i class="<%= s[:icon] %>" aria-hidden="true"></i></a></li>
        <% end %>
      </ul>

      <a href="#top" class="site-footer__top">
        <%= t("footer.back_to_top") %> <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
      </a>
    </div>
    <div class="wrap site-footer__legal">
      <p>© <%= Date.current.year %> Albert Nikolli. <%= t("footer.rights") %></p>
      <p><%= t("home.first_section.p_intro_2") %></p>
    </div>
  </footer>
</div>
